; test-auto.script -- run on the Amiga from tests/ folder to automate DCTelnet test
;
;   Start the Telnet test-server Docker container first (see tests/Dockerfile), then:
;
;   EXECUTE test-auto.script
;

; Keep this path in sync with INSTALLDIR in src/Makefile; make install places the binaries used by
; this script here.
SET INSTALLDIR   /build/installed/DCTelnet

SET Iteration   3

; Allow this script to be executed directly for subsequent runs:
PROTECT #?.rexx   +SRE  QUIET
PROTECT #?.script +SRE  QUIET

ECHO "Install device and libraries in AmigaOS. *E[35mYou MUST reboot if these files have changed:*E[0m"
LIST "${INSTALLDIR}/Devs/ibmcon.device" DEVS:ibmcon.device NOHEAD
ECHO ""
LIST "${INSTALLDIR}/Libs/ssh.library"   LIBS:ssh.library   NOHEAD
ECHO ""
COPY "${INSTALLDIR}/Devs/ibmcon.device"  TO DEVS:  DATES
COPY "${INSTALLDIR}/Libs/ssh.library"    TO LIBS:  DATES


ECHO "Copy ANSI test file..."
COPY  FROM test-speed.ans    TO "${INSTALLDIR}"    DATES
; for older DCTelnet build compatibility:
COPY  FROM test-speed.ans    TO "${INSTALLDIR}/speedtest.ans"    DATES


DELETE "${INSTALLDIR}/DCTelnet.Prefs"
ECHO "*E[32mChoose 'PAL:High Res' to generate a new Prefs file.*E[0m"
"${INSTALLDIR}/DCTelnet.68000" --test-speed  >NIL:

; Log test context: binary sizes and version information
; AmigaShell's LFORMAT is a flexible way to format output as JSON:
echo "{*"binaries*": ["
LIST "${INSTALLDIR}/DCTelnet.68000" LFORMAT=" { *"filename*":*"%P%N*", *"size*":%L,"
ECHO "   *"version*": *"`VERSION "${INSTALLDIR}/DCTelnet.68000" FULL`*","
ECHO "   `"${INSTALLDIR}/DCTelnet.68000" --build-info`},"

LIST "DEVS:ibmcon.device" LFORMAT=" { *"filename*":*"%P%N*", *"size*":%L,"
; FIXME: VERSION ibmcon.device with KS 2.04 : Error 8000 0003
ECHO "   *"version*": null},"

LIST "LIBS:ssh.library" LFORMAT=" { *"filename*":*"%P%N*", *"size*":%L,"
ECHO "   *"version*": *"`VERSION LIBS:ssh.library FULL`*"}],"

; Run the performance benchmarks:
echo  "*"benchmarks*": ["
test-speed.rexx builtin ${Iteration}
echo ","
test-speed.rexx console ${Iteration}
echo ","
test-speed.rexx xem     ${Iteration}
echo ","
test-speed.rexx ibmcon  ${Iteration}

echo "]}"